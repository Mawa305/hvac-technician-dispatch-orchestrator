    {
      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body || {};\nconst errors = [];\nconst clean = v => String(v || '').trim();\nconst name = clean(b.name);\nconst email = clean(b.email);\nconst phone = clean(b.phone);\nconst address = clean(b.address);\nconst zone = clean(b.zone);\nconst serviceType = clean(b.service_type).toLowerCase();\nconst urgency = (clean(b.urgency) || 'normal').toLowerCase();\nif (!name || name.length > 100) errors.push('name is required');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push('valid email is required');\nif (!/^[0-9+\\- ]{7,20}$/.test(phone)) errors.push('valid phone is required');\nif (address.length < 5) errors.push('address is required');\nif (!zone) errors.push('zone is required');\nif (!['ac', 'heating', 'plumbing', 'other'].includes(serviceType)) errors.push('service_type must be AC, Heating, Plumbing or Other');\nif (!['normal', 'emergency'].includes(urgency)) errors.push('urgency must be normal or emergency');\nreturn [{ json: {\n  valid: errors.length === 0,\n  errors,\n  dispatchId: 'DSP-' + Date.now(),\n  name, email, phone, address, zone, serviceType, urgency\n} }];\n"
      },
