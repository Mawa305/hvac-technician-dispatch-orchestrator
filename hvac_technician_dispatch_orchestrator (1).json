      "parameters": {
        "jsCode": "\nconst res = $input.first().json;\nconst base = $('Build Match Prompt').first().json;\nconst { systemPrompt, userPrompt, candidates, needsHuman, ...job } = base;\nlet chosen = null;\nlet reason = '';\ntry {\n  const p = JSON.parse(res.output);\n  chosen = candidates.find(c => c.techId === String(p.techId)) || null;\n  reason = String(p.reason || '');\n} catch (e) {}\nreturn [{ json: { ...job, chosen, reason } }];\n"
      },
